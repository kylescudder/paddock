PORT=3000
APP_URL=http://localhost:3000
# Generated backgrounds, cached renders and fonts. State itself lives in PostgreSQL.
DATA_DIR=./data

# Local development database (see README). The host uses DATABASE_PASSWORD_FILE instead of a password in the URL.
DATABASE_URL=postgres://postgres:paddock@127.0.0.1:55432/paddock_dev

# Better Auth sign-in; keep server-side. Only AUTH_ALLOWED_EMAILS can sign in.
# Mail (Brevo) may be left unset outside production: no codes or links are sent.
BETTER_AUTH_URL=http://localhost:3000
# Stable random secret of at least 32 characters, e.g. `openssl rand -hex 32`.
BETTER_AUTH_SECRET=
# Comma-separated owner emails.
AUTH_ALLOWED_EMAILS=
# BREVO_API_KEY=<Paddock transactional API key>
# AUTH_EMAIL_FROM=paddock@thescudders.org
# AUTH_EMAIL_DAILY_LIMIT=40

# Server-only OpenRouter key. Model is chosen in the owner's Settings screen.
OPENROUTER_API_KEY=

# Emby connects from the host. API key stays server-side.
EMBY_URL=
EMBY_API_KEY=

# The host uses the existing platform Tunnel/Caddy network; see deploy/README.md.
PADDOCK_DATA_DIR=./data
# Set by the verified deployer, not to a mutable tag.
PADDOCK_IMAGE=
