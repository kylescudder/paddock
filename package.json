{
  "name": "paddock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "tsc --noEmit && bunx --bun vite build",
    "start": "bun server/production.ts",
    "test": "bun test tests",
    "setup": "bun scripts/setup.ts",
    "db:migrate": "bun server/migrate.ts",
    "import": "python3 scripts/import-archive.py",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "bunx --no-install playwright test --config e2e/playwright.config.ts",
    "test:e2e:sign-in": "bunx --no-install playwright test --config e2e/sign-in.config.ts",
    "test:connections": "bun deploy/test-connection-budget.ts",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:check": "bun --bun drizzle-kit check"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@better-auth-ui/core": "1.7.33",
    "@better-auth-ui/react": "1.7.33",
    "@better-auth/drizzle-adapter": "1.7.18",
    "@better-auth/passkey": "1.7.18",
    "@clerk/backend": "^3.25.0",
    "@clerk/tanstack-react-start": "^1.7.3",
    "@t3-oss/env-core": "0.13.11",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "better-auth": "1.7.18",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.5.2",
    "date-fns": "4.4.0",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "fontkit": "^2.0.4",
    "input-otp": "1.5.0",
    "lucide-react": "^1.59.0",
    "postgres": "^3.4.9",
    "radix-ui": "1.8.1",
    "react": "^19.2.3",
    "react-day-picker": "10.0.2",
    "react-dom": "^19.2.3",
    "sharp": "^0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.3.0",
    "@types/fontkit": "^2.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
