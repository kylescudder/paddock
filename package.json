{
  "name": "paddock",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite dev",
    "build": "tsc --noEmit && bunx --bun vite build",
    "start": "bun server/production.ts",
    "test": "bun test tests",
    "setup": "bun scripts/setup.ts",
    "db:migrate": "bun server/migrate.ts",
    "import": "python3 scripts/import-archive.py",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "bunx --no-install playwright test --config e2e/playwright.config.ts",
    "test:e2e:sign-in": "bunx --no-install playwright test --config e2e/sign-in.config.ts",
    "test:connections": "bun deploy/test-connection-budget.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "dependencies": {
    "@clerk/backend": "^3.25.0",
    "@clerk/tanstack-react-start": "^1.7.3",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "fontkit": "^2.0.4",
    "lucide-react": "^1.59.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.3.0",
    "@types/fontkit": "^2.0.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
