{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": ["bun", "vite/client"]
  },
  "include": [
    "src",
    "server",
    "shared",
    "scripts/*.ts",
    "tests",
    "vite.config.ts",
    "drizzle.config.ts",
    "e2e"
  ]
}
